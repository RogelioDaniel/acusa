  "/api/auth/token": {
   "post": {
    "tags": [
     "Autenticación"
    ],
    "summary": "Obtener un token de una hora",
    "security": [],
    "parameters": [
     {
      "name": "x-api-key",
      "in": "header",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "Su llave de API (`ak_…`)."
     }
    ],
    "responses": {
     "200": {
      "description": "Token.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "token": {
           "type": "string"
          },
          "expiraEnSegundos": {
           "type": "integer",
           "example": 3600
          }
         }
        }
       }
      }
     },
     "401": {
      "description": "Llave inválida o revocada."
     }
    }
   }
  },
