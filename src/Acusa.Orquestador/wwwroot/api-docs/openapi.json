{
  "openapi": "3.0.1",
  "info": {
    "title": "Acusa · API de facturación",
    "version": "v1",
    "description": "Facturación electrónica sobre CONTPAQi Comercial.\n\n- **Autenticación:** `Authorization: Bearer <llave de API>`.\n- **Identificadores:** al crear o buscar se recibe un `id`; las demás rutas lo usan.\n- **Respuesta:** hasta 30 s de espera; después `202` con `tareaId`.\n- **Errores:** `{ codigo, detalles, idCorrelacion }`.\n- **Duplicados:** `Idempotency-Key` o `referencia` evitan crear dos veces la misma factura.\n"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Autenticación"
    },
    {
      "name": "Empresas"
    },
    {
      "name": "Clientes"
    },
    {
      "name": "Productos"
    },
    {
      "name": "Documentos"
    },
    {
      "name": "Tareas"
    }
  ],
  "paths": {
    "/api/auth/token": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Obtener un token de una hora",
        "security": [],
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Token."
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
