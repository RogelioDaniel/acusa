  "/api/empresas/{empresa}/documentos": {
   "parameters": [
    {
     "$ref": "#/components/parameters/empresa"
    }
   ],
   "post": {
    "tags": [
     "Documentos"
    ],
    "summary": "Crear un documento (factura) sin timbrar",
    "description": "Valida los datos, actualiza en el cliente el régimen fiscal y el uso de CFDI, y crea el documento en Comercial con sus movimientos. Devuelve el concepto, la serie y el folio, que identifican al documento en el resto de las rutas.\n\n`usoCfdi` y `regimenFiscal` son obligatorios. Los impuestos de cada movimiento son opcionales: `ivaPorcentaje`, `retencionIvaPorcentaje` e `iepsPorcentaje`, de 0 a 100.\n",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/DocumentoNuevo"
       },
       "example": {
        "concepto": "5",
        "serie": "A",
        "clienteCodigo": "CLI0001",
        "fecha": "2026-11-12",
        "formaPago": "03",
        "usoCfdi": "G03",
        "regimenFiscal": "601",
        "referencia": "FAC-0001",
        "movimientos": [
         {
          "productoCodigo": "SERV0001",
          "unidades": 2,
          "precio": 2000,
          "ivaPorcentaje": 16,
          "retencionIvaPorcentaje": 0,
          "iepsPorcentaje": 0
         }
        ]
       }
      }
     }
    },
    "responses": {
     "201": {
      "$ref": "#/components/responses/Resultado"
     },
     "202": {
      "$ref": "#/components/responses/EnCurso"
     },
     "401": {
      "$ref": "#/components/responses/NoAutorizado"
     },
     "404": {
      "$ref": "#/components/responses/EmpresaNoRegistrada"
     },
     "422": {
      "$ref": "#/components/responses/Fallo"
     }
    }
   }
  },
  "/api/empresas/{empresa}/documentos/timbrado": {
   "parameters": [
    {
     "$ref": "#/components/parameters/empresa"
    }
   ],
   "post": {
    "tags": [
     "Documentos"
    ],
    "summary": "Timbrar varios documentos en una sola orden",
    "description": "Hasta 25 documentos. El worker los timbra de uno en uno (cada timbrado tarda de 5 a 10 segundos) y la respuesta detalla el resultado de cada uno; si pasan 60 segundos responde `202` y el detalle se consulta en la tarea.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Lote"
       },
       "example": {
        "documentos": [
         {
          "concepto": "5",
          "serie": "A",
          "folio": 1
         },
         {
          "concepto": "5",
          "serie": "A",
          "folio": 2
         }
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "$ref": "#/components/responses/Resultado"
     },
     "202": {
      "$ref": "#/components/responses/EnCurso"
     },
     "401": {
      "$ref": "#/components/responses/NoAutorizado"
     },
     "404": {
      "$ref": "#/components/responses/EmpresaNoRegistrada"
     },
     "422": {
      "$ref": "#/components/responses/Fallo"
     }
    }
   }
  },
