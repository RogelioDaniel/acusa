  "/api/sdk/tasks/{tareaId}": {
   "get": {
    "tags": [
     "Tareas"
    ],
    "summary": "Consultar una tarea",
    "description": "Sirve cuando una petición respondió `202`. Con `esperar` la respuesta aguarda a que la tarea termine.",
    "parameters": [
     {
      "name": "tareaId",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "esperar",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "minimum": 0,
       "maximum": 120
      },
      "description": "Segundos que la respuesta espera a que la tarea termine."
     }
    ],
    "responses": {
     "200": {
      "description": "Estado y resultado de la tarea."
     },
     "401": {
      "$ref": "#/components/responses/NoAutorizado"
     },
     "404": {
      "description": "No existe la tarea."
     }
    }
   }
  },
  "/api/sdk/workers": {
   "get": {
    "tags": [
     "Tareas"
    ],
    "summary": "Listar los workers y si están en línea",
    "responses": {
     "200": {
      "description": "Lista de workers."
     },
     "401": {
      "$ref": "#/components/responses/NoAutorizado"
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "bearerAuth": {
    "type": "http",
    "scheme": "bearer",
    "description": "Llave de API (`ak_…`) o token de `POST /api/auth/token`."
   }
  },
  "parameters": {
   "empresa": {
    "name": "empresa",
    "in": "path",
    "required": true,
    "schema": {
     "type": "string",
     "example": "adEMPRESA_EJEMPLO"
    },
    "description": "Empresa de CONTPAQi (carpeta de la empresa). Debe estar registrada en Acusa Central."
   },
   "codigo": {
    "name": "codigo",
    "in": "path",
    "required": true,
    "schema": {
     "type": "string"
    },
    "description": "Código en Comercial."
   },
   "concepto": {
    "name": "concepto",
    "in": "path",
    "required": true,
    "schema": {
     "type": "string",
     "example": "5"
    },
    "description": "Código del concepto de documento."
   },
   "serie": {
    "name": "serie",
    "in": "path",
    "required": true,
    "schema": {
     "type": "string",
     "example": "A"
    },
    "description": "Serie del documento. Use `-` si no tiene serie."
   },
   "folio": {
    "name": "folio",
    "in": "path",
    "required": true,
    "schema": {
     "type": "integer",
     "example": 1
    },
    "description": "Folio que devolvió la creación del documento."
   }
  },
  "responses": {
   "Resultado": {
    "description": "La operación terminó. Trae `tareaId` y `resultado` con los datos que devolvió Comercial.",
    "content": {
     "application/json": {
      "schema": {
       "type": "object",
       "properties": {
        "tareaId": {
         "type": "string"
        },
        "resultado": {
         "type": "object"
        }
       }
      }
     }
    }
   },
   "EnCurso": {
    "description": "Pasaron 60 segundos y el worker sigue trabajando. Consulte `GET /api/sdk/tasks/{tareaId}` (también en la cabecera `Location`).",
    "content": {
     "application/json": {
      "schema": {
       "type": "object",
       "properties": {
        "tareaId": {
         "type": "string"
        },
        "estado": {
         "type": "string",
         "example": "EnProceso"
        }
       }
      }
     }
    }
   },
   "Fallo": {
    "description": "Datos inválidos (`errors`) o la operación falló en Comercial (`error`, `codigoSdk`).",
    "content": {
     "application/json": {
      "schema": {
       "type": "object",
       "properties": {
        "errors": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "error": {
         "type": "string"
        },
        "codigoSdk": {
         "type": "integer",
         "nullable": true
        },
        "tareaId": {
         "type": "string"
        }
       }
      }
     }
    }
   },
   "NoAutorizado": {
    "description": "Falta la cabecera Authorization o la llave no es válida."
   },
   "EmpresaNoRegistrada": {
    "description": "La empresa no está registrada para su cuenta."
   }
  },
  "schemas": {
   "ClienteNuevo": {
    "type": "object",
    "required": [
     "codigo",
     "razonSocial",
     "rfc"
    ],
    "properties": {
     "codigo": {
      "type": "string"
     },
     "razonSocial": {
      "type": "string"
     },
     "rfc": {
      "type": "string"
     },
     "tipoCliente": {
      "type": "integer",
      "description": "1 cliente",
      "2 cliente/proveedor": null,
      "3 proveedor": null,
      "example": 1
     },
     "limiteCredito": {
      "type": "number"
     },
     "email": {
      "type": "string"
     },
     "regimenFiscal": {
      "type": "string",
      "description": "Clave SAT",
      "example": "601"
     },
     "usoCfdi": {
      "type": "string",
      "description": "Clave SAT",
      "example": "G03"
     }
    }
   },
   "ClienteCambios": {
    "type": "object",
    "properties": {
     "razonSocial": {
      "type": "string"
     },
     "rfc": {
      "type": "string"
     },
     "limiteCredito": {
      "type": "number"
     },
     "email": {
      "type": "string"
     },
     "regimenFiscal": {
      "type": "string"
     },
     "usoCfdi": {
      "type": "string"
     }
    }
   },
   "ProductoNuevo": {
    "type": "object",
    "required": [
     "codigo",
     "nombre",
     "unidadBase"
    ],
    "properties": {
     "codigo": {
      "type": "string"
     },
     "nombre": {
      "type": "string"
     },
     "unidadBase": {
      "type": "string",
      "description": "Debe existir en la empresa",
      "example": "Pieza"
     },
     "precio1": {
      "type": "number"
     },
     "descripcion": {
      "type": "string"
     },
     "claveSat": {
      "type": "string",
      "example": "81112200"
     },
     "tipoProducto": {
      "type": "integer",
      "description": "1 producto",
      "2 paquete": null,
      "3 servicio": null,
      "example": 3
     },
     "textosExtra": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   },
   "DocumentoNuevo": {
    "type": "object",
    "required": [
     "concepto",
     "clienteCodigo",
     "fecha",
     "formaPago",
     "usoCfdi",
     "regimenFiscal",
     "movimientos"
    ],
    "properties": {
     "concepto": {
      "type": "string",
      "example": "5"
     },
     "serie": {
      "type": "string",
      "example": "A"
     },
     "clienteCodigo": {
      "type": "string"
     },
     "fecha": {
      "type": "string",
      "format": "date",
      "description": "aaaa-mm-dd"
     },
     "formaPago": {
      "type": "string",
      "description": "Clave SAT de forma de pago",
      "example": "03"
     },
     "usoCfdi": {
      "type": "string",
      "description": "Clave SAT",
      "obligatoria": null,
      "example": "G03"
     },
     "regimenFiscal": {
      "type": "string",
      "description": "Clave SAT",
      "obligatoria": null,
      "example": "601"
     },
     "referencia": {
      "type": "string",
      "description": "Hasta 20 caracteres; si no se manda",
      "Acusa genera una": null
     },
     "movimientos": {
      "type": "array",
      "minItems": 1,
      "items": {
       "$ref": "#/components/schemas/Movimiento"
      }
     }
    }
   },
   "Movimiento": {
    "type": "object",
    "required": [
     "productoCodigo",
     "unidades",
     "precio"
    ],
    "properties": {
     "productoCodigo": {
      "type": "string"
     },
     "unidades": {
      "type": "number",
      "minimum": 0,
      "exclusiveMinimum": true
     },
     "precio": {
      "type": "number",
      "minimum": 0
     },
     "almacen": {
      "type": "string",
      "description": "Si no se manda",
      "el almacén por omisión de la cuenta": null
     },
     "ivaPorcentaje": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "example": 16
     },
     "retencionIvaPorcentaje": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
     },
     "iepsPorcentaje": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
     }
    }
   },
   "Direccion": {
    "type": "object",
    "required": [
     "codigoPostal"
    ],
    "properties": {
     "tipo": {
      "type": "string",
      "enum": [
       "fiscal",
       "envio"
      ],
      "description": "Por omisión fiscal"
     },
     "calle": {
      "type": "string"
     },
     "numeroExterior": {
      "type": "string"
     },
     "numeroInterior": {
      "type": "string"
     },
     "colonia": {
      "type": "string"
     },
     "codigoPostal": {
      "type": "string"
     },
     "municipio": {
      "type": "string"
     },
     "ciudad": {
      "type": "string"
     },
     "estado": {
      "type": "string"
     },
     "pais": {
      "type": "string"
     }
    }
   },
   "ProductoCambios": {
    "type": "object",
    "properties": {
     "nombre": {
      "type": "string"
     },
     "descripcion": {
      "type": "string"
     },
     "precio1": {
      "type": "number"
     },
     "claveSat": {
      "type": "string"
     },
     "textosExtra": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   },
   "Lote": {
    "type": "object",
    "required": [
     "documentos"
    ],
    "properties": {
     "documentos": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
       "type": "object",
       "required": [
        "concepto",
        "folio"
       ],
       "properties": {
        "concepto": {
         "type": "string"
        },
        "serie": {
         "type": "string",
         "description": "Sin serie",
         "omítala o use `-`": null
        },
        "folio": {
         "type": "integer"
        },
        "motivo": {
         "type": "string",
         "enum": [
          "01",
          "02",
          "03",
          "04"
         ],
         "description": "Solo en cancelación"
        },
        "uuidSustituto": {
         "type": "string"
        }
       }
      }
     }
    }
   },
   "Cancelacion": {
    "type": "object",
    "required": [
     "motivo"
    ],
    "properties": {
     "motivo": {
      "type": "string",
      "enum": [
       "01",
       "02",
       "03",
       "04"
      ]
     },
     "uuidSustituto": {
      "type": "string",
      "description": "Obligatorio con el motivo 01"
     }
    }
   },
   "Timbrado": {
    "type": "object",
    "properties": {
     "tareaId": {
      "type": "string"
     },
     "concepto": {
      "type": "string"
     },
     "serie": {
      "type": "string",
      "nullable": true
     },
     "folio": {
      "type": "integer"
     },
     "uuid": {
      "type": "string"
     },
     "estado": {
      "type": "string",
      "example": "timbrada"
     },
     "xml": {
      "type": "string",
      "nullable": true,
      "description": "XML del CFDI timbrado en texto plano. Es null si Comercial no lo entregó a tiempo; se pide con GET …/xml."
     },
     "resultado": {
      "type": "object"
     }
    }
   }
  }
 },
 "security": [
  {
   "bearerAuth": []
  }
 ]
}