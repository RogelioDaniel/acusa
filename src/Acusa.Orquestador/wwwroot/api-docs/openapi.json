     {
      "name": "x-api-key",
      "in": "header",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Token."
     },
     "401": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
