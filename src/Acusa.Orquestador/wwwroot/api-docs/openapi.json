 },
 "components": {
  "securitySchemes": {
   "bearerAuth": {
    "type": "http",
    "scheme": "bearer"
   }
  },
  "parameters": {
   "empresa": {
    "name": "empresa",
    "in": "path",
    "required": true,
    "schema": {
     "type": "string",
     "example": "adEMPRESA_EJEMPLO"
    }
   },
   "id": {
    "name": "id",
    "in": "path",
    "required": true,
    "schema": {
     "type": "integer",
     "format": "int64"
    }
   },
   "idempotencia": {
    "name": "Idempotency-Key",
    "in": "header",
    "required": false,
    "schema": {
     "type": "string",
     "maxLength": 100
    }
   }
  },
  "responses": {
   "Resultado": {
    "description": "Correcto.",
    "content": {
     "application/json": {
      "schema": {
       "type": "object",
       "properties": {
        "id": {
         "type": "integer",
         "format": "int64",
         "nullable": true
        },
        "tareaId": {
         "type": "string"
        },
        "resultado": {
         "type": "object"
        }
       }
      }
     }
    }
   },
   "EnCurso": {
    "description": "El worker sigue trabajando.",
    "content": {
     "application/json": {
      "schema": {
       "type": "object",
       "properties": {
        "id": {
         "type": "integer",
         "format": "int64",
         "nullable": true
        },
        "tareaId": {
         "type": "string"
        },
        "estado": {
         "type": "string",
         "example": "EnProceso"
        }
       }
      }
     }
    }
   },
   "Error": {
    "description": "Error.",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      },
      "example": {
       "codigo": "validacion",
       "mensaje": "La solicitud tiene errores de validación.",
       "detalles": [
        "Pais no puede estar vacio"
       ],
       "idCorrelacion": "9f3c1a7e52b04d68"
      }
     }
    }
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "properties": {
     "codigo": {
      "type": "string",
      "enum": [
       "solicitud_invalida",
       "no_autorizado",
       "no_encontrado",
       "conflicto",
       "validacion",
       "operacion_fallida",
       "error_sdk",
       "demasiados_intentos",
       "error_interno"
      ]
     },
     "mensaje": {
      "type": "string"
     },
     "detalles": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "idCorrelacion": {
      "type": "string"
     },
     "codigoSdk": {
      "type": "integer"
     },
     "tareaId": {
      "type": "string"
     }
    }
   },
   "ClienteNuevo": {
    "type": "object",
    "required": [
     "codigo",
     "razonSocial",
     "rfc",
     "codigoPostal",
     "pais"
    ],
    "properties": {
     "codigo": {
      "type": "string"
     },
     "razonSocial": {
      "type": "string"
     },
     "rfc": {
      "type": "string"
     },
     "tipoCliente": {
      "type": "integer",
      "enum": [
       1,
       2,
       3
      ]
     },
     "limiteCredito": {
      "type": "number"
     },
     "regimenFiscal": {
      "type": "string"
     },
     "usoCfdi": {
      "type": "string"
     },
     "codigoPostal": {
      "type": "string"
     },
     "pais": {
      "type": "string"
     },
     "calle": {
      "type": "string"
     },
     "numeroExterior": {
      "type": "string"
     },
     "numeroInterior": {
      "type": "string"
     },
     "colonia": {
      "type": "string"
     },
     "municipio": {
      "type": "string"
     },
     "ciudad": {
      "type": "string"
     },
     "estado": {
      "type": "string"
     }
    }
   },
   "ClienteCambios": {
    "type": "object",
    "properties": {
     "razonSocial": {
      "type": "string"
     },
     "rfc": {
      "type": "string"
     },
     "limiteCredito": {
      "type": "number"
     },
     "regimenFiscal": {
      "type": "string"
     },
     "usoCfdi": {
      "type": "string"
     }
    }
   },
   "DireccionNueva": {
    "type": "object",
    "required": [
     "codigoPostal",
     "pais"
    ],
    "properties": {
     "tipoDireccion": {
      "type": "integer",
      "enum": [
       0,
       1
      ],
      "default": 0,
      "description": "0 fiscal, 1 envío"
     },
     "codigoPostal": {
      "type": "string"
     },
     "pais": {
      "type": "string"
     },
     "calle": {
      "type": "string"
     },
