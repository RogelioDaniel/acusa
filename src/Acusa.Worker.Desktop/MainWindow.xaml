<Window x:Class="Acusa.Worker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="acusa.ico" Title="Acusa Worker" Width="980" Height="640" MinWidth="860" MinHeight="540"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Foreground="{StaticResource Tinta}">
    <Window.Background><SolidColorBrush Color="#F2F4EE"/></Window.Background>

    <Grid Margin="22,16,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Margin="0,0,14,0"><Viewbox Width="46" Height="46"><Canvas Width="32" Height="32"><Path Fill="#0B6B50" Data="M7,2 L21,2 L28,9 L28,28 A2,2 0 0 1 26,30 L7,30 A2,2 0 0 1 5,28 L5,4 A2,2 0 0 1 7,2 Z"/><Path Fill="#FFFFFF" Opacity="0.4" Data="M21,2 L28,9 L23,9 A2,2 0 0 1 21,7 Z"/><Path Stroke="White" StrokeThickness="2.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M10.5,25 L16,10.5 L21.5,25 M12.5,20.2 L19.5,20.2"/></Canvas></Viewbox></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Acusa Worker" FontSize="24" FontWeight="ExtraBold"/>
                <TextBlock x:Name="Subtitulo" Text="Ejecuta en este equipo las órdenes de Acusa Central sobre CONTPAQi Comercial" Foreground="{StaticResource Suave}" FontSize="13"/>
            </StackPanel>
            <Border Grid.Column="2" x:Name="PildoraEstado" CornerRadius="999" Padding="16,7" Background="#F3F4F6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="PuntoEstado" Width="9" Height="9" Fill="#9CA3AF" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TextoEstado" Text="Detenido" FontWeight="Bold" FontSize="13"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Configuración -->
            <ScrollViewer Grid.Column="0" x:Name="PanelConfig" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Tarjeta}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Conexión" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="Estos datos se guardan en este equipo, salvo las contraseñas." Foreground="{StaticResource Suave}" FontSize="12" Margin="0,2,0,4" TextWrapping="Wrap"/>

                        <TextBlock Style="{StaticResource Etiqueta}" Text="Dirección de Acusa Central"/>
                        <TextBox x:Name="CajaUrl" Text="http://127.0.0.1:5090"/>

                        <TextBlock Style="{StaticResource Etiqueta}" Text="Llave del worker"/>
                        <PasswordBox x:Name="CajaLlave"/>

                        <TextBlock Style="{StaticResource Etiqueta}" Text="Empresa de CONTPAQi (carpeta)"/>
                        <TextBox x:Name="CajaEmpresa"/>

                        <CheckBox x:Name="CheckSimulado"><TextBlock TextWrapping="Wrap" Text="Modo simulado (sin CONTPAQi, solo para probar el ciclo)"/></CheckBox>

                        <Separator Margin="0,16,0,6" Background="#D8DED2"/>
                        <TextBlock Text="Escritura y timbrado" FontSize="15" FontWeight="Bold" Margin="0,6,0,0"/>
                        <CheckBox x:Name="CheckDocumentos"><TextBlock TextWrapping="Wrap" Text="Permitir crear documentos (consume folios)"/></CheckBox>
                        <CheckBox x:Name="CheckTimbrado"><TextBlock TextWrapping="Wrap" Text="Permitir timbrar y cancelar (gasta timbres, avisa al SAT)"/></CheckBox>
                        <TextBlock Style="{StaticResource Etiqueta}" Text="Contraseña del certificado (CSD)"/>
                        <PasswordBox x:Name="CajaCsd"/>
                        <CheckBox x:Name="CheckRecordarCsd"><TextBlock TextWrapping="Wrap" Text="Recordar la contraseña cifrada en este equipo (para que timbre tras un reinicio automático)"/></CheckBox>
                        <TextBlock Style="{StaticResource Etiqueta}" Text="Contraseña del usuario del SDK (para el servicio; vacía si SUPERVISOR no la tiene)"/>
                        <PasswordBox x:Name="CajaClaveSdk"/>
                        <CheckBox x:Name="CheckCsdComercial"><TextBlock TextWrapping="Wrap" Text="No usar contraseña propia: que Comercial la tenga guardada"/></CheckBox>
                        <TextBlock Style="{StaticResource Etiqueta}" Text="Clientes con código fuera de PRUEBA permitidos"/>
                        <TextBox x:Name="CajaClientes" ToolTip="Códigos separados por coma. Solo para probar con un receptor real."/>
                        <Separator Margin="0,16,0,6" Background="#D8DED2"/>
                        <TextBlock Text="Arranque" FontSize="15" FontWeight="Bold" Margin="0,6,0,0"/>
                        <CheckBox x:Name="CheckInicioWindows"><TextBlock TextWrapping="Wrap" Text="Abrir y arrancar el worker al iniciar sesión este usuario; si se cae, se reinicia solo"/></CheckBox>
                        <TextBlock Text="Las contraseñas no se muestran ni se escriben en la bitácora. La del certificado solo se guarda si lo marca arriba." Foreground="{StaticResource Suave}" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Estado y bitácora -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Tarjeta}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Style="{StaticResource Rotulo}" Text="EN EJECUCIÓN"/><TextBlock x:Name="DatoTiempo" Text="—" FontSize="22" FontWeight="ExtraBold" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Rotulo}" Text="ÓRDENES HECHAS"/><TextBlock x:Name="DatoHechas" Text="0" FontSize="22" FontWeight="ExtraBold" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Rotulo}" Text="FALLIDAS"/><TextBlock x:Name="DatoFallos" Text="0" FontSize="22" FontWeight="ExtraBold" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Grid.Column="3"><TextBlock Style="{StaticResource Rotulo}" Text="CÓDIGO DEL PANEL"/><TextBlock x:Name="DatoCodigo" Text="—" FontSize="22" FontWeight="ExtraBold" FontFamily="Consolas" Margin="0,4,0,0"/></StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Bitácora en vivo" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button x:Name="BotonLimpiar" Content="Limpiar" Style="{StaticResource BotonSuave}" Padding="14,5" FontSize="12" HorizontalAlignment="Right" Click="Limpiar_Click"/>
                        </Grid>
                        <TextBox Grid.Row="1" x:Name="Bitacora" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Background="#0F172A" Foreground="#CBD5E1"
                                 BorderThickness="0" Padding="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Botones -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
            <Button x:Name="BotonIniciar" Content="Iniciar worker" Style="{StaticResource BotonPrincipal}" Click="Iniciar_Click"/>
            <Button x:Name="BotonDetener" Content="Detener" Style="{StaticResource BotonSuave}" Margin="10,0,0,0" IsEnabled="False" Click="Detener_Click"/>
            <Button x:Name="BotonPanel" Content="Abrir panel del worker" Style="{StaticResource BotonSuave}" Margin="10,0,0,0" IsEnabled="False" Click="Panel_Click"/>
            <Button x:Name="BotonAsistente" Content="Asistente de configuración" Style="{StaticResource BotonSuave}" Margin="10,0,0,0" Click="Asistente_Click"/>
            <Button x:Name="BotonServicio" Content="Instalar servicio de Windows" Style="{StaticResource BotonSuave}" Margin="10,0,0,0" Click="InstalarServicio_Click"/>
            <Button x:Name="BotonQuitarServicio" Content="Quitar servicio" Style="{StaticResource BotonSuave}" Margin="10,0,0,0" Visibility="Collapsed" Click="QuitarServicio_Click"/>
            <TextBlock x:Name="TextoRuta" Foreground="{StaticResource Suave}" FontSize="11.5" VerticalAlignment="Center" Margin="18,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
