<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Acusa.Worker.Desktop</RootNamespace>
    <AssemblyName>Acusa.Worker.Desktop</AssemblyName>
    <ApplicationTitle>Acusa Worker</ApplicationTitle>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Acusa Worker</Product>
    <Company>Local Solutions IT</Company>
    <Description>Acusa Worker: ejecuta en CONTPAQi Comercial las órdenes de Acusa Central.</Description>
    <Copyright>Local Solutions IT</Copyright>
    <ApplicationIcon>acusa.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="acusa.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

</Project>
